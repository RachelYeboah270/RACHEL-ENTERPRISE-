<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Product Management & Sales Dashboard</title>
    <style>
        * { box-sizing: border-box; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; margin: 0; padding: 0; }
        body { background-color: #f4f6f9; padding: 20px; color: #333; }
        .header { background-color: #1a252f; color: white; padding: 20px; border-radius: 8px; margin-bottom: 20px; display: flex; justify-content: space-between; align-items: center; }
        .container { display: grid; grid-template-columns: 350px 1fr; gap: 20px; }
        @media (max-width: 800px) { .container { grid-template-columns: 1fr; } }
        .card { background: white; padding: 20px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.05); margin-bottom: 20px; }
        h2 { margin-bottom: 15px; font-size: 1.2rem; color: #2c3e50; border-bottom: 2px solid #eee; padding-bottom: 8px; }
        .form-group { margin-bottom: 15px; }
        label { display: block; margin-bottom: 5px; font-weight: 600; font-size: 0.9rem; }
        input, select, textarea { width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 5px; font-size: 0.9rem; }
        button { background-color: #27ae60; color: white; border: none; padding: 12px 20px; border-radius: 5px; cursor: pointer; font-weight: bold; width: 100%; }
        button:hover { background-color: #219150; }
        .product-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 20px; }
        .product-card { background: white; border-radius: 8px; border: 1px solid #e1e8ed; overflow: hidden; display: flex; flex-direction: column; }
        .product-card img { width: 100%; height: 180px; object-fit: cover; }
        .product-details { padding: 15px; flex-grow: 1; display: flex; flex-direction: column; }
        .product-title { font-weight: bold; font-size: 1.1rem; margin-bottom: 5px; }
        .product-price { color: #e74c3c; font-weight: bold; font-size: 1.2rem; margin-bottom: 10px; }
        .product-desc { font-size: 0.85rem; color: #666; margin-bottom: 15px; flex-grow: 1; }
        .share-buttons { display: flex; gap: 5px; margin-top: 10px; }
        .btn-share { padding: 8px; border: none; border-radius: 4px; font-size: 0.8rem; font-weight: bold; cursor: pointer; text-decoration: none; text-align: center; flex: 1; color: white; }
        .btn-wa { background-color: #25D366; }
        .btn-fb { background-color: #1877F2; }
    </style>
</head>
<body>

    <div class="header">
        <h1>Store Manager Dashboard</h1>
        <div id="product-count">Total Items: 0</div>
    </div>

    <div class="container">
        <!-- Add Product Panel -->
        <div class="card">
            <h2>Add New Product</h2>
            <form id="productForm">
                <div class="form-group">
                    <label>Product Name</label>
                    <input type="text" id="title" placeholder="e.g. Commercial Blender" required>
                </div>
                <div class="form-group">
                    <label>Price (GHS)</label>
                    <input type="number" id="price" placeholder="0.00" required>
                </div>
                <div class="form-group">
                    <label>Category</label>
                    <select id="category">
                        <option value="Kitchen Appliance">Kitchen Appliance</option>
                        <option value="Fashion & Bags">Fashion & Bags</option>
                        <option value="Home Goods">Home Goods</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Image URL</label>
                    <input type="url" id="image" placeholder="https://example.com/image.jpg" required>
                </div>
                <div class="form-group">
                    <label>WhatsApp Number (with country code)</label>
                    <input type="text" id="phone" value="233279448137" required>
                </div>
                <div class="form-group">
                    <label>Description & Terms</label>
                    <textarea id="description" rows="3" placeholder="Enter delivery terms, features..."></textarea>
                </div>
                <button type="submit">Post Product to Dashboard</button>
            </form>
        </div>

        <!-- Live Products Grid -->
        <div>
            <div class="card">
                <h2>Active Listings</h2>
                <div class="product-grid" id="productGrid">
                    <!-- Dynamic products will load here -->
                </div>
            </div>
        </div>
    </div>

    <script>
        const form = document.getElementById('productForm');
        const productGrid = document.getElementById('productGrid');
        const productCount = document.getElementById('product-count');

        // Load saved products from local memory
        let products = JSON.parse(localStorage.getItem('my_dashboard_products')) || [];

        function saveAndRender() {
            localStorage.setItem('my_dashboard_products', JSON.stringify(products));
            renderProducts();
        }

        function renderProducts() {
            productGrid.innerHTML = '';
            productCount.innerText = `Total Items: ${products.length}`;

            if(products.length === 0) {
                productGrid.innerHTML = '<p>No products posted yet. Fill out the form to add your first item.</p>';
                return;
            }

            products.forEach((product, index) => {
                const encodedMsg = encodeURIComponent(`Hello, I want to buy: ${product.title} for GHS ${product.price}. Please let me know how to proceed.`);
                const waLink = `https://wa.me/${product.phone}?text=${encodedMsg}`;
                const fbLink = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(window.location.href)}`;

                const card = document.createElement('div');
                card.className = 'product-card';
                card.innerHTML = `
                    <img src="${product.image}" alt="${product.title}" onerror="this.src='https://via.placeholder.com/250x180?text=No+Image+Found'">
                    <div class="product-details">
                        <div class="product-title">${product.title}</div>
                        <div class="product-price">GHS ${parseFloat(product.price).toFixed(2)}</div>
                        <div class="product-desc">${product.description}</div>
                        <div class="share-buttons">
                            <a href="${waLink}" target="_blank" class="btn-share btn-wa">Buy / Order</a>
                            <a href="${fbLink}" target="_blank" class="btn-share btn-fb">Share FB</a>
                        </div>
                    </div>
                `;
                productGrid.appendChild(card);
            });
        }

        form.addEventListener('submit', (e) => {
            e.preventDefault();
            const newProduct = {
                title: document.getElementById('title').value,
                price: document.getElementById('price').value,
                category: document.getElementById('category').value,
                image: document.getElementById('image').value,
                phone: document.getElementById('phone').value,
                description: document.getElementById('description').value
            };
            products.push(newProduct);
            saveAndRender();
            form.reset();
        });

        // Initial render on page load
        renderProducts();
    </script>
</body>
</html>
